{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "plugin": ["typedoc-plugin-missing-exports", "typedoc-plugin-markdown"],
  "internalModule": "field-types",
  "name": "Krieg API",
  "entryPointStrategy": "resolve",
  "tsconfig": "tsconfig.json",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "disableGit": true,
  "displayBasePath": ".",
  "gitRevision": "main",
  "sourceLinkTemplate": "https://github.com/maxmixalex/krieg-lang/blob/{gitRevision}/{path}#L{line}",
  "router": "member",
  "entryFileName": "index",
  "hidePageHeader": true,
  "hideBreadcrumbs": false,
  "useHTMLAnchors": true,
  "useHTMLEncodedBrackets": true,
  "expandParameters": true,
  "indexFormat": "table",
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "typeDeclarationFormat": "table",
  "categorizeByGroup": false,
  "tableColumnSettings": { "hideInherited": true, "hideSources": false },
  "navigation": {
    "includeCategories": true,
    "includeGroups": true,
    "includeFolders": false
  },
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  }
}
