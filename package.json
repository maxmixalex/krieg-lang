{
  "name": "krieg-lang",
  "version": "0.3.0",
  "description": "A statically compiled TypeScript subset and project toolchain for Hearts of Iron IV mods",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxmixalex/krieg-lang.git"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "bin": {
    "krieg": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    },
    "./hoi4": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./pdx": {
      "types": "./dist/pdx/index.d.ts",
      "import": "./dist/pdx/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/jsx-runtime": {
      "types": "./dist/ui/jsx-runtime.d.ts",
      "import": "./dist/ui/jsx-runtime.js"
    },
    "./project": {
      "types": "./dist/project/index.d.ts",
      "import": "./dist/project/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "import": "./dist/eslint/index.js"
    },
    "./schema/krgconfig.schema.json": "./schemas/krgconfig.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "templates",
    "README.md",
    "NOTICE.md",
    "third_party"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-data.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:examples": "node scripts/test-examples.mjs",
    "test:package": "node scripts/test-package.mjs",
    "docs:api": "node scripts/generate-api.mjs",
    "docs:api:check": "node scripts/generate-api.mjs --check",
    "docs:coverage": "node scripts/check-coverage.mjs",
    "prepack": "npm run build",
    "generate:domains": "node scripts/generate-domains.mjs --from-schema",
    "generate:domains:check": "node scripts/generate-domains.mjs --check",
    "generate:defines": "node scripts/generate-defines.mjs --from-schema",
    "generate:defines:check": "node scripts/generate-defines.mjs --check",
    "audit:gui": "node scripts/audit-native-gui.mjs",
    "audit:domains": "node scripts/audit-native-domains.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "npm run docs:api:check && npm run docs:coverage && npm run docs:build",
    "docs:links": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "luaparse": "0.3.1",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-plugin-missing-exports": "4.1.4"
  }
}
