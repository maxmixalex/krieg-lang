{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxmixalex/krieg-lang/raw/main/schemas/krgconfig.schema.json",
  "title": "Krieg project",
  "description": "A statically compiled HOI4 mod and its assets.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "sourceDir": { "type": "string", "default": "src" },
    "outDir": { "type": "string", "default": "build/mod" },
    "strictAssets": { "type": "boolean", "default": true },
    "railways": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes"],
      "description": "Plan additive land railways against the final effective map. The entire inherited railways.txt is preserved; conflicting levels are errors.",
      "properties": {
        "allowEmptyBase": { "type": "boolean", "default": false },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "level", "via"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
              "level": { "type": "integer", "minimum": 1, "maximum": 5 },
              "via": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "integer", "minimum": 1 }
              },
              "avoidProvinces": { "$ref": "#/$defs/geographicIds" },
              "avoidStates": { "$ref": "#/$defs/geographicIds" },
              "avoidStrategicRegions": { "$ref": "#/$defs/geographicIds" }
            }
          }
        }
      }
    },
    "mod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "default": "0.1.0" },
        "supportedVersion": { "type": "string", "default": "1.19.*" },
        "tags": { "$ref": "#/$defs/strings" },
        "replacePath": { "$ref": "#/$defs/strings" },
        "dependencies": { "$ref": "#/$defs/strings" },
        "picture": { "type": "string" },
        "userDir": { "type": "string" }
      }
    },
    "dependencies": {
      "$ref": "#/$defs/strings",
      "description": "Installed npm Krieg packages or local project paths, in load order."
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "override": { "type": "boolean", "default": false }
        }
      }
    },
    "localisation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "language"],
        "properties": {
          "from": { "type": "string" },
          "format": {
            "enum": ["json", "yaml", "hoi4"],
            "description": "Defaults by extension: .json flat JSON mapping, .yaml flat YAML mapping, .yml native HOI4 localisation preserved with a UTF-8 BOM."
          },
          "language": {
            "enum": [
              "english",
              "french",
              "german",
              "spanish",
              "braz_por",
              "polish",
              "russian",
              "japanese",
              "simp_chinese",
              "korean"
            ]
          }
        }
      }
    },
    "gameRoots": {
      "type": "array",
      "description": "Game and mod directories in effective load order. These are read, never copied into the output.",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "replacePath": { "$ref": "#/$defs/strings" }
            }
          }
        ]
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "countries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{2}$" }
        },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "geographicIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
  }
}
